/* =========================================================
   RESEARCH — LESS BOXY, MORE EDITORIAL
   ========================================================= */

.research-section {
  background: #eeeeE8;
}

.research-grid {
  gap: 1px;
  border: 0;
  background: var(--line-dark);
}

.research-card {
