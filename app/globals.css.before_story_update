   ========================================================= */

.skill-groups {
  gap: 1px;
  border: 0;
  background: var(--line);
}

.skill-group {
  min-height: 420px;
  display: flex;
  flex-direction: column;
  border: 0;
  background: var(--surface);
}

.skill-group-index {
  margin-bottom: 56px;
