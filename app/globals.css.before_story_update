.skill {
  background: #f7f7f3;
  transition:
    color 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease;
}

.skill:hover {
  color: #fff;
  background: var(--text);
  border-color: var(--text);
}


/* =========================================================
   DIGITAL TWIN — FLAGSHIP FEATURE
   ========================================================= */

.twin-section {
  padding-top: 105px;
  padding-bottom: 105px;
}

.twin-shell {
  position: relative;
  overflow: hidden;
  padding: 46px;
  border-radius: 26px;
}

.twin-shell::before {
  content: "";
  position: absolute;
  width: 360px;
  height: 360px;
  right: -120px;
  top: -170px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
