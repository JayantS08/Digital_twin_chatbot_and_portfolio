/* =========================================================
   EXISTING PROJECT CASE STUDY STYLES
   ========================================================= */
   PROJECT CASE STUDY
   ========================================================= */

   .project-page {
    min-height: 100vh;
    padding: 130px 0 120px;
    background: #fff;
  }
  
  .project-page .container {
    max-width: 1180px;
  }
  
  /* Back navigation */
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #777;
  
    margin-bottom: 80px;
  
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  
  .back-link:hover {
    color: #111;
    transform: translateX(-5px);
  }
  
  /* =========================================================
     HERO
     ========================================================= */
  
  .project-hero {
    padding-bottom: 90px;
  }
  
  .project-hero .section-number {
    margin-bottom: 25px;
  }
  
  .project-hero h1 {
    max-width: 1050px;
  
    margin: 0;
  
    font-size: clamp(52px, 6.2vw, 88px);
    line-height: 0.94;
    letter-spacing: -0.065em;
    font-weight: 600;
  
    color: #111;
    text-wrap: balance;
  }
  
  /* Project metadata */
  
  .project-info {
    display: grid;
    grid-template-columns: 220px 220px;
  
    gap: 50px;
  
    margin-top: 65px;
    padding-top: 22px;
  
    border-top: 1px solid #111;
  }
  
  .project-info div {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  
  .project-info span {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #999;
  }
  
  .project-info strong {
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
  }
  
  /* =========================================================
     CASE STUDY SECTIONS
     ========================================================= */
  
  .case-section {
    display: grid;
  
    grid-template-columns: 220px minmax(0, 1fr);
  
    gap: 80px;
  
    padding: 85px 0;
  
    border-top: 1px solid var(--line);
  }
  
  .case-label {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #888;
  
    padding-top: 7px;
  }
  
  .case-content {
    max-width: 760px;
  }
  
  .case-content h2 {
    margin: 0 0 28px;
  
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.98;
  
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  
  .case-lead {
    margin: 0;
  
    font-size: 24px;
    line-height: 1.6;
  
    letter-spacing: -0.02em;
  
    color: #333;
  }
  
  .case-placeholder {
    margin: 0;
  
    padding: 22px 25px;
  
    border: 1px dashed #d5d5d0;
    border-radius: 4px;
  
    color: #777;
  
    font-size: 15px;
    line-height: 1.8;
  
    background: #fafaf8;
  }
  
  /* =========================================================
     TECHNOLOGIES
     ========================================================= */
  
  .case-tags {
    display: flex;
    flex-wrap: wrap;
  
    gap: 9px;
  }
  
  .case-tags .skill {
    background: #fff;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  
  .case-tags .skill:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  
    transform: translateY(-2px);
  }
  
  /* =========================================================
     FOOTER
     ========================================================= */
  
  .case-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  
    padding-top: 55px;
  }
  
  /* =========================================================
     SMALL ACCENT DETAILS
     ========================================================= */
  
  .project-page::selection {
    background: #111;
    color: #fff;
  }
  
  /* =========================================================
     MOBILE
     ========================================================= */
  
  @media (max-width: 800px) {
  
    .project-page {
      padding: 110px 0 80px;
    }
  
    .back-link {
      margin-bottom: 55px;
    }
  
    .project-hero {
      padding-bottom: 65px;
    }
  
    .project-hero h1 {
      font-size: 15vw;
      line-height: 0.92;
    }
  
    .project-info {
      grid-template-columns: 1fr 1fr;
  
      gap: 25px;
  
      margin-top: 45px;
    }
  
    .case-section {
      grid-template-columns: 1fr;
  
      gap: 25px;
  
      padding: 60px 0;
    }
  
    .case-label {
      padding-top: 0;
    }
  
    .case-content h2 {
      font-size: 38px;
    }
  
    .case-lead {
      font-size: 20px;
    }
  
    .case-footer {
      padding-top: 40px;
    }
  }
  
  @media (max-width: 500px) {
  
    .project-info {
      grid-template-columns: 1fr;
    }
  
    .project-hero h1 {
      font-size: 16vw;
    }
  
    .case-content h2 {
      font-size: 34px;
    }
  
    .case-lead {
      font-size: 19px;
    }
  }
